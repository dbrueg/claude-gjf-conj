import GJF.CertZ12A
import GJF.CertZ12B
import GJF.CertZ12K3

/-!
# The ℤ/12-chains (Main Question, `gcd(k, 24) ∈ {3, 6, 12}`)

The group is generated by `g` with `g⁶ = -1` (six signed 6-cycles on 36 coordinates), and
`h = g⁴` has order 3 and no fixed coordinate. The seeds (`SeedZ12Data.lean`) are normalised so that
`h` is a pure permutation (notes/blueprint/chains-and-seeds.md Lemma 2.6), and every block map of
`g` is `A 1`.

* Chain A (`σ_A6`, 3 blocks): stage 0 gives length 72, then every multiple of 72.
* Chain B (`σ_B6`, 6 blocks, already a uniform state): lengths `36 + 72j`, `j ≥ 1`.
* `k = 3`: the seed `z12seed_len36_3` itself.

Along the chains `T_h = R^h_σ(seed) = 0` (`Twined.lean`, Lemma 2.3).

* `exists_Z12`: for every `k ≡ 0 mod 3` a self-dual code of length `12k` with index 24, and
  `g ∈ Aut(C)` with `g⁶ = -1`, `g⁴` without fixed coordinate and `T_{g⁴}(C) = 0`.
-/

open Finset

set_option linter.unusedSectionVars false
set_option synthInstance.maxSize 2048

attribute [-instance] instAddCommGroupOfIsSimpleAddGroupOfIsNilpotent

namespace GJF.Ex

local notation "F" => ZMod 3

namespace Z12

open Eval

/-- The shift `i ↦ i + 1` of `Fin 3`. -/
def shift : Equiv.Perm (Fin 3) := Equiv.addRight 1

/-- The orbit structure of `Fin 3` under the shift. -/
def ψ3 : Fin 1 × Fin 3 ≃ Fin 3 where
  toFun x := x.2
  invFun i := (0, i)
  left_inv x := by rcases x with ⟨a, i⟩; fin_cases a; rfl
  right_inv _ := rfl

lemma orbS_shift4 : OrbS (shift ^ 4) ψ3 := by unfold OrbS; decide

lemma shift_pow6 : shift ^ 6 = 1 := by decide

/-- The invariant of a ℤ/12 state: `g⁶ = -1`, `h = g⁴` a permutation with identity local maps and
no fixed singleton, and `R^h = 0`. -/
def QZ {S : Type} [Fintype S] [DecidableEq S] (E : Submodule F (Blk S (Fin 3 × Fin 2) → F))
    (gens : Unit → SM S (Fin 3 × Fin 2)) : Prop :=
  gens () ^ 6 = -1 ∧ (gens () ^ 4).PureL ∧ (gens () ^ 4).gS.FPF ∧
    Rh (gens () ^ 4) (orbProd ψ3) E = 0

/-- The invariant of a code: `g⁶ = -1`, `g⁴` without fixed coordinate, `T_{g⁴} = 0`. -/
def QZ' {X : Type} [Fintype X] [DecidableEq X] (C : Submodule F (X → F)) (gens : Unit → SP X) :
    Prop :=
  gens () ^ 6 = -1 ∧ (gens () ^ 4).FPF ∧ Th (gens () ^ 4) C = 0

lemma qz'_of {S B B' : Type} [Fintype S] [DecidableEq S] [Fintype B] [DecidableEq B]
    [Fintype B'] [DecidableEq B'] (E : Submodule F (Blk S B → F)) {g : SM S B} (h6 : g ^ 6 = -1)
    (hp : (g ^ 4).PureL) (hS : (g ^ 4).gS.FPF) {ψ : B' × Fin 3 ≃ B} (hψ : OrbS (g ^ 4).π ψ)
    (hR : Rh (g ^ 4) ψ E = 0) : QZ' (Qt E) (fun _ => (SM.step1 g).extD) := by
  refine ⟨?_, ?_, ?_⟩
  · show (SM.step1 g).extD ^ 6 = -1
    rw [← SM.extD_pow, ← SM.step1_pow, h6, SM.step1_neg, SM.step1_one, SM.extD_neg, SM.extD_one]
  · show ((SM.step1 g).extD ^ 4).FPF
    rw [← SM.extD_pow, ← SM.step1_pow]
    exact FPF_st1_extD hp hS hψ
  · show Th ((SM.step1 g).extD ^ 4) (Qt E) = 0
    rw [← SM.extD_pow, ← SM.step1_pow, Th_Qt E hp hψ, hR]

lemma qz_step {S : Type} [Fintype S] [DecidableEq S] (E : Submodule F (Blk S (Fin 3 × Fin 2) → F))
    {g : SM S (Fin 3 × Fin 2)} (hu : Unif g shift) (hq : QZ E (fun _ => g)) :
    QZ (NSt (spO (Fin 3)) E) (fun _ => nxt g shift) := by
  obtain ⟨h6, hp, hS, hR⟩ := hq
  have hu4 := hu.pow 4
  have hψ : OrbS (g ^ 4).π (orbProd ψ3) := by rw [hu4.1]; exact orbS_shift4.prodCongr
  refine ⟨?_, ?_, ?_, ?_⟩
  · show nxt g shift ^ 6 = -1
    rw [← nxt_pow hu, h6, shift_pow6, nxt_negOne]
  · show (nxt g shift ^ 4).PureL
    rw [← nxt_pow hu]; exact hp.newSM _ _
  · show (nxt g shift ^ 4).gS.FPF
    rw [← nxt_pow hu]; exact FPF_newSM_gS hp hS hψ hu4.compat
  · show Rh (nxt g shift ^ 4) (orbProd ψ3) (NSt (spO (Fin 3)) E) = 0
    rw [← nxt_pow hu]
    unfold nxt
    rw [Rh_NSt _ E hp hψ hu4.compat orbS_shift4]
    exact hR

lemma qz'_step {S : Type} [Fintype S] [DecidableEq S] (E : Submodule F (Blk S (Fin 3 × Fin 2) → F))
    {g : SM S (Fin 3 × Fin 2)} (hu : Unif g shift) (hq : QZ E (fun _ => g)) :
    QZ' (Qt E) (fun _ => (SM.step1 g).extD) := by
  obtain ⟨h6, hp, hS, hR⟩ := hq
  have hψ : OrbS (g ^ 4).π (orbProd ψ3) := by rw [(hu.pow 4).1]; exact orbS_shift4.prodCongr
  exact qz'_of E h6 hp hS hψ hR

lemma chain {n : ℕ} (h : UState (Fin 3) Unit (fun _ => shift) QZ n) (j : ℕ) :
    GCode Unit QZ' (n + 72 * (j + 1)) := by
  have := ustate_chain (Q := QZ) (Q' := QZ') (πO := fun _ => shift) ?_ ?_ h j
  · simpa using this
  · intro S _ _ E gens _ hu hq
    exact qz_step E (hu ()) hq
  · intro S _ _ E gens _ hu hq
    exact qz'_step E (hu ()) hq

lemma QZ'_pull {X Y : Type} [Fintype X] [DecidableEq X] [Fintype Y] [DecidableEq Y] (e : Y ≃ X)
    (C : Submodule F (X → F)) (gens : Unit → SP X) (hq : QZ' C gens) :
    QZ' (relabel e C) (fun i => SP.pull e (gens i)) := by
  obtain ⟨h6, hF, hT⟩ := hq
  refine ⟨?_, ?_, ?_⟩
  · show SP.pull e (gens ()) ^ 6 = -1
    rw [← SP.pull_pow, h6, SP.pull_neg, SP.pull_one]
  · show (SP.pull e (gens ()) ^ 4).FPF
    rw [← SP.pull_pow]; exact hF.pull e
  · show Th (SP.pull e (gens ()) ^ 4) (relabel e C) = 0
    rw [← SP.pull_pow, Th_relabel, hT]

end Z12

/-! ### Chain A -/

namespace Z12A

open Eval Z12

noncomputable def E : Submodule F (Fin 36 → F) := codeS 36 rows

lemma sys : Sys info := by unfold Sys; decide

lemma orth : ∀ r r', ∑ i, gen 36 rows r i * gen 36 rows r' i = 0 := by decide

theorem selfDual : SelfDualG E := selfDual_codeS sys orth rfl

def gf : SP (Fin 36) := ⟨⟨gperm, ginv, by decide, by decide⟩, gsgn, by decide⟩

theorem gf_inv : gf.Inv E := Inv_codeS (info := info) gf (by decide)

lemma c_bij : Function.Bijective c := by decide

noncomputable def e : Blk (Fin 24) (Fin 3) ≃ Fin 36 := Equiv.ofBijective c c_bij

noncomputable def E0 : Submodule F (Blk (Fin 24) (Fin 3) → F) := relabel e E

def gM : SM (Fin 24) (Fin 3) :=
  ⟨⟨⟨gSperm, gSinv, by decide, by decide⟩, gSsgn, by decide⟩, shift, fun _ => (1, false)⟩

lemma gM_c : ∀ i, c (gM.toSP.perm i) = gf.perm (c i) ∧ gM.toSP.sgn i = gf.sgn (c i) := by decide

lemma gM_toSP : gM.toSP = SP.pull e gf := toSP_of_c c_bij gM_c

lemma gM_inv : gM.toSP.Inv E0 := by rw [gM_toSP]; exact gf_inv.pull _

lemma gM6 : gM ^ 6 = -1 := by decide

lemma gM4_pure : (gM ^ 4).PureL := ⟨by unfold SP.Pure; decide, by decide⟩

lemma gM4_fpf : (gM ^ 4).gS.FPF := by unfold SP.FPF; decide

lemma gM4_orb : OrbS (gM ^ 4).π ψ3 := by unfold OrbS; decide

theorem R_E0 : R E0 = 24 := by
  rw [E0, e, E, R_seed 36 rows c c_bij (Equiv.refl _) sys (by decide) sL bL (by decide) (by decide)
    tree rfl (by decide)]
  exact fastR

theorem fastRh : fastT (WtF sL bLrep) ftree 0 0 = 0 := by decide +kernel

lemma sysF : Sys (n := 36) (rows := frows) J := by unfold Sys; decide

lemma memF : ∀ j, gen 36 frows j ∈ codeS 36 rows := fun j =>
  mem_codeS_of_sys (info := info) (by revert j; decide)

lemma fixF : ∀ j, (gf ^ 4).act (gen 36 frows j) = gen 36 frows j := by decide

lemma certL : ∀ r r' : Fin 18, ((L r).map fun cl => cl.2 * fixForm (rows := rows) (gf ^ 4) J cl.1 r').sum =
    if r = r' then 1 else 0 := by decide

theorem Rh_E0 : Rh (gM ^ 4) ψ3 E0 = 0 := by
  rw [E0, e, E, Rh_seed c c_bij (gM ^ 4) (gf ^ 4) (by rw [SM.toSP_pow, gM_toSP, SP.pull_pow]; rfl) ψ3
    (Equiv.refl (Fin 1)) sysF memF fixF L certL (by decide) sL bLrep (by decide) (by decide) ftree
    rfl (by decide)]
  exact fastRh

/-- Stage 0 refines the step-one blocks `(β, 0)`. -/
def sp0 : Fin 3 × Fin 2 ≃ Fin 3 ⊕ Fin 3 where
  toFun x := if x.2 = 0 then .inl x.1 else .inr x.1
  invFun y := y.elim (fun i => (i, 0)) (fun i => (i, 1))
  left_inv := by decide
  right_inv := by decide

lemma compat : SM.Compat sp0 gM shift shift := by unfold SM.Compat; decide

theorem a_state : GCode Unit QZ' 72 ∧ UState (Fin 3) Unit (fun _ => shift) QZ 72 := by
  have hc4 := compat.pow 4
  have h := stage0 (Q := QZ) (Q' := QZ') E0 (selfDual_relabel _ selfDual) R_E0 (fun _ => gM)
    (fun _ => gM_inv) sp0 (fun _ => shift) (fun _ => shift) (fun _ => compat) ?_ ?_
  · simpa using h
  · refine ⟨?_, ?_, ?_, ?_⟩
    · show SM.newSM sp0 gM shift shift ^ 6 = -1
      rw [← SM.newSM_pow compat, gM6, shift_pow6, SM.newSM_neg, SM.newSM_one]
    · show (SM.newSM sp0 gM shift shift ^ 4).PureL
      rw [← SM.newSM_pow compat]; exact gM4_pure.newSM _ _
    · show (SM.newSM sp0 gM shift shift ^ 4).gS.FPF
      rw [← SM.newSM_pow compat]; exact FPF_newSM_gS gM4_pure gM4_fpf gM4_orb hc4
    · show Rh (SM.newSM sp0 gM shift shift ^ 4) (orbProd ψ3) (NSt sp0 E0) = 0
      rw [← SM.newSM_pow compat, Rh_NSt sp0 E0 gM4_pure gM4_orb hc4 orbS_shift4, Rh_E0]
  · exact qz'_of E0 gM6 gM4_pure gM4_fpf gM4_orb Rh_E0

theorem codes (j : ℕ) : GCode Unit QZ' (72 * (j + 1)) := by
  rcases j with _ | j
  · simpa using a_state.1
  · have := Z12.chain a_state.2 j
    rwa [show 72 + 72 * (j + 1) = 72 * (j + 1 + 1) by ring] at this

end Z12A

end GJF.Ex

namespace GJF.Ex

local notation "F" => ZMod 3

/-! ### Chain B -/

namespace Z12B

open Eval Z12

noncomputable def E : Submodule F (Fin 36 → F) := codeS 36 rows

lemma sys : Sys info := by unfold Sys; decide

lemma orth : ∀ r r', ∑ i, gen 36 rows r i * gen 36 rows r' i = 0 := by decide

theorem selfDual : SelfDualG E := selfDual_codeS sys orth rfl

def gf : SP (Fin 36) := ⟨⟨gperm, ginv, by decide, by decide⟩, gsgn, by decide⟩

theorem gf_inv : gf.Inv E := Inv_codeS (info := info) gf (by decide)

lemma c_bij : Function.Bijective c := by decide

noncomputable def e : Blk (Fin 12) (Fin 3 × Fin 2) ≃ Fin 36 := Equiv.ofBijective c c_bij

noncomputable def E0 : Submodule F (Blk (Fin 12) (Fin 3 × Fin 2) → F) := relabel e E

/-- `g` moves block `(i, o)` to `(i + 1, o)`. -/
def gM : SM (Fin 12) (Fin 3 × Fin 2) :=
  ⟨⟨⟨gSperm, gSinv, by decide, by decide⟩, gSsgn, by decide⟩, Equiv.prodCongr shift 1,
    fun _ => (1, false)⟩

lemma gM_c : ∀ i, c (gM.toSP.perm i) = gf.perm (c i) ∧ gM.toSP.sgn i = gf.sgn (c i) := by decide

lemma gM_toSP : gM.toSP = SP.pull e gf := toSP_of_c c_bij gM_c

lemma gM_inv : gM.toSP.Inv E0 := by rw [gM_toSP]; exact gf_inv.pull _

lemma gM6 : gM ^ 6 = -1 := by decide

lemma gM4_pure : (gM ^ 4).PureL := ⟨by unfold SP.Pure; decide, by decide⟩

lemma gM4_fpf : (gM ^ 4).gS.FPF := by unfold SP.FPF; decide

/-- The blocks listed orbit by orbit. -/
def eB : Fin 6 ≃ Fin 3 × Fin 2 where
  toFun j := (⟨j.val % 3, Nat.mod_lt _ (by norm_num)⟩, ⟨j.val / 3, by omega⟩)
  invFun x := ⟨x.1.val + 3 * x.2.val, by omega⟩
  left_inv := by decide
  right_inv := by decide

/-- The two orbit representatives `(0, o)`. -/
def eR : Fin 2 ≃ Fin 1 × Fin 2 where
  toFun j := (0, j)
  invFun x := x.2
  left_inv _ := rfl
  right_inv x := by rcases x with ⟨a, j⟩; fin_cases a; rfl

theorem R_E0 : R E0 = 24 := by
  rw [E0, e, E, R_seed 36 rows c c_bij eB sys (by decide) sL bL (by decide) (by decide) tree rfl
    (by decide)]
  exact fastR

theorem fastRh : fastT (WtF sL bLrep) ftree 0 0 = 0 := by decide +kernel

lemma sysF : Sys (n := 36) (rows := frows) J := by unfold Sys; decide

lemma memF : ∀ j, gen 36 frows j ∈ codeS 36 rows := fun j =>
  mem_codeS_of_sys (info := info) (by revert j; decide)

lemma fixF : ∀ j, (gf ^ 4).act (gen 36 frows j) = gen 36 frows j := by decide

lemma certL : ∀ r r' : Fin 18, ((L r).map fun cl => cl.2 * fixForm (rows := rows) (gf ^ 4) J cl.1 r').sum =
    if r = r' then 1 else 0 := by decide

theorem Rh_E0 : Rh (gM ^ 4) (orbProd ψ3) E0 = 0 := by
  rw [E0, e, E, Rh_seed c c_bij (gM ^ 4) (gf ^ 4) (by rw [SM.toSP_pow, gM_toSP, SP.pull_pow]; rfl)
    (orbProd ψ3) eR sysF memF fixF L certL (by decide) sL bLrep (by decide) (by decide) ftree rfl
    (by decide)]
  exact fastRh

/-- The seed with `σ_B6` is already a uniform state (`O = Fin 3`). -/
theorem b_state : UState (Fin 3) Unit (fun _ => shift) QZ 36 :=
  ⟨Fin 12, inferInstance, inferInstance, E0, fun _ => gM, selfDual_relabel _ selfDual, R_E0, rfl,
    fun _ => ⟨rfl, fun _ => rfl⟩, fun _ => gM_inv, gM6, gM4_pure, gM4_fpf, Rh_E0⟩

theorem codes (j : ℕ) : GCode Unit QZ' (36 + 72 * (j + 1)) := Z12.chain b_state j

end Z12B

/-! ### `k = 3` -/

namespace Z12K3

open Eval Z12

noncomputable def C : Submodule F (Fin 36 → F) := codeS 36 rows

lemma sys : Sys info := by unfold Sys; decide

lemma orth : ∀ r r', ∑ i, gen 36 rows r i * gen 36 rows r' i = 0 := by decide

theorem selfDual : SelfDualG C := selfDual_codeS sys orth rfl

def gf : SP (Fin 36) := ⟨⟨gperm, ginv, by decide, by decide⟩, gsgn, by decide⟩

theorem gf_inv : gf.Inv C := Inv_codeS (info := info) gf (by decide)

lemma g6 : gf ^ 6 = -1 := by decide

lemma g4_fpf : (gf ^ 4).FPF := by unfold SP.FPF; decide

theorem index_C : indexG C = 24 := by
  rw [C, indexG_seed sys (by decide) sL (by decide) tree rfl (by decide)]
  exact fastI

theorem fastT0 : fastT (WtF sL []) ftree 0 0 = 0 := by decide +kernel

lemma sysF : Sys (n := 36) (rows := frows) J := by unfold Sys; decide

lemma memF : ∀ j, gen 36 frows j ∈ codeS 36 rows := fun j =>
  mem_codeS_of_sys (info := info) (by revert j; decide)

lemma fixF : ∀ j, (gf ^ 4).act (gen 36 frows j) = gen 36 frows j := by decide

lemma certL : ∀ r r' : Fin 18, ((L r).map fun cl => cl.2 * fixForm (rows := rows) (gf ^ 4) J cl.1 r').sum =
    if r = r' then 1 else 0 := by decide

theorem Th_C : Th (gf ^ 4) C = 0 := by
  rw [C, Th_seed (gf ^ 4) sysF memF fixF L certL (by decide) sL (by decide) ftree rfl (by decide)]
  exact fastT0

theorem code : GCode Unit QZ' 36 :=
  ⟨Fin 36, inferInstance, inferInstance, C, fun _ => gf, selfDual, index_C, by simp,
    fun _ => gf_inv, g6, g4_fpf, Th_C⟩

end Z12K3

namespace Z12

/-- **The ℤ/12-chains.** For every `k ≡ 0 mod 3` there is a self-dual ternary code of length `12k`
with index `24` and a signed permutation `g ∈ Aut(C)` with `g⁶ = -1` such that `h = g⁴` has no fixed
coordinate and `T_h(C) = 0`. -/
theorem exists_Z12 (k : ℕ) (hk : 3 ∣ k) (hk0 : 0 < k) :
    ∃ (C : Submodule F (Fin (12 * k) → F)) (g : SP (Fin (12 * k))),
      IsSelfDual C ∧ gjfIndex C = 24 ∧ g.Inv C ∧ g ^ 6 = -1 ∧ (g ^ 4).FPF ∧ Th (g ^ 4) C = 0 := by
  have hG : GCode Unit QZ' (12 * k) := by
    obtain ⟨m, rfl⟩ := hk
    rcases Nat.even_or_odd m with ⟨j, hj⟩ | ⟨j, hj⟩
    · obtain ⟨i, rfl⟩ : ∃ i, j = i + 1 := ⟨j - 1, by omega⟩
      have := Z12A.codes i
      rwa [show 72 * (i + 1) = 12 * (3 * m) by omega] at this
    · rcases j with _ | j
      · have := Z12K3.code
        rwa [show 36 = 12 * (3 * m) by omega] at this
      · have := Z12B.codes j
        rwa [show 36 + 72 * (j + 1) = 12 * (3 * m) by omega] at this
  obtain ⟨C, gens, hC, hI, hinv, h6, hF, hT⟩ := GCode.toFin (Q' := QZ') QZ'_pull hG
  exact ⟨C, gens (), hC, hI, hinv (), h6, hF, hT⟩

end Z12

end GJF.Ex
